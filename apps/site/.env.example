NEXT_PUBLIC_API_URL="http://localhost:3003"

# Staff routes: /{NEXT_PUBLIC_STAFF_PATH}/kitchen and /{NEXT_PUBLIC_STAFF_PATH}/admin
# Defaults to "staff" when unset.
NEXT_PUBLIC_STAFF_PATH="staff"

# Base URL of the customer PWA (QR links in admin, home page demo link).
NEXT_PUBLIC_CUSTOMER_URL="http://localhost:3001"

# Staff auth uses JWT. Login at /{NEXT_PUBLIC_STAFF_PATH}/login
# Demo users are seeded by prisma db seed (password: demo1234)
# KITCHEN_DEV_TOKEN remains an optional local fallback when NODE_ENV=development
KITCHEN_DEV_TOKEN="dev-kitchen-token-change-me"
# Set to the same value as KITCHEN_DEV_TOKEN for kitchen realtime in local dev
NEXT_PUBLIC_KITCHEN_DEV_TOKEN="dev-kitchen-token-change-me"

# Copy the printed Store ID from prisma db seed.
NEXT_PUBLIC_KITCHEN_STORE_ID=""
